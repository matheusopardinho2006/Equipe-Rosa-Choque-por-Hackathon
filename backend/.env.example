PORT=3333
# MongoDB Atlas: copie a connection string do cluster (Database > Connect > Drivers)
MONGO_URI=mongodb+srv://USUARIO:SENHA@CLUSTER.mongodb.net/auto-tm?retryWrites=true&w=majority
# Plano B para a demo sem internet:
# MONGO_URI=mongodb://127.0.0.1:27017/auto-tm
CORS_ORIGIN=http://localhost:5173

# Firebase Console > Project settings > General
FIREBASE_PROJECT_ID=seu-projeto-firebase
# Firebase Console > Project settings > Service accounts > Generate new private key
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-...@seu-projeto-firebase.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nCOLE_A_CHAVE_PRIVADA_AQUI\n-----END PRIVATE KEY-----\n"

# UID do usuário criado em Firebase Authentication > Users.
# Esse UID receberá o perfil ADM ao rodar npm run seed.
ADMIN_FIREBASE_UID=uid-do-administrador
# Opcional: rótulo exibido no log do seed
ADMIN_EMAIL=admin@exemplo.com
